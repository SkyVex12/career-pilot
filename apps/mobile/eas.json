{
  "cli": {
    "version": ">=16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true
    },
    "http-test": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_MOBILE_HTTP_TEST": "true"
      },
      "android": {
        "gradleCommand": ":app:assembleHttpTest"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
