{
  "expo": {
    "name": "CoRuby",
    "slug": "career-pilot-mobile",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "scheme": "careerpilot",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.careerpilot.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.careerpilot.mobile",
      "permissions": ["RECORD_AUDIO"],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.CAMERA"
      ],
      "allowBackup": false
    },
    "plugins": [
      "./plugins/withHttpTest.cjs",
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": "Record only when you explicitly start practice, an in-person turn, or Talk to host.",
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "react-native-audio-api",
        {
          "iosBackgroundMode": false,
          "iosMicrophonePermission": "Record only when you explicitly start practice, an in-person turn, or Talk to host.",
          "androidPermissions": [
            "android.permission.RECORD_AUDIO",
            "android.permission.MODIFY_AUDIO_SETTINGS"
          ],
          "androidForegroundService": false
        }
      ],
      "@livekit/react-native-expo-plugin",
      [
        "@config-plugins/react-native-webrtc",
        {
          "microphonePermission": "Record only when you explicitly start practice, an in-person turn, or Talk to host."
        }
      ]
    ],
    "icon": "./assets/icon.png",
    "platforms": ["ios", "android"]
  }
}
