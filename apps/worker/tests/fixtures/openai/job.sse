event: response.output_text.done
data: {"type":"response.output_text.done","content_index":0,"item_id":"msg_0c418fddccaecfd8016ac678839f2887d290e87d5c2d4b311b","logprobs":[],"output_index":0,"sequence_number":277,"text":"{\n  \"company\": \"Globex\",\n  \"title\": \"Staff Backend Engineer, Payments Infrastructure\",\n  \"summary\": \"Globex needs a Staff Backend Engineer to lead the reliability and scale of its payments infrastructure, own ledger and payout system design, set technical direction for three teams, and mentor senior engineers. The role involves strongly consistent, high-throughput payment systems, zero-downtime data store migrations, and improvements to on-call health and operational excellence. Candidates need 8+ years building distributed backend systems in Go, Python or Java, deep PostgreSQL and Kafka experience, and a record of leading cross-team technical projects.\",\n  \"description\": \"Staff Backend Engineer, Payments Infrastructure — Globex\\n\\nGlobex is hiring a Staff Backend Engineer to lead the reliability and scale of our payments infrastructure. You will own the design of our ledger and payout systems, set technical direction for three teams, and mentor senior engineers.\\n\\nYou will\\n- Design and evolve high-throughput, strongly consistent payment systems.\\n- Lead migrations of critical data stores without downtime.\\n- Improve on-call health and operational excellence across teams.\\n\\nYou have\\n- 8+ years building distributed backend systems (Go, Python or Java).\\n- Deep experience with PostgreSQL and event streaming (Kafka).\\n- A record of leading cross-team technical projects.\"\n}"}

