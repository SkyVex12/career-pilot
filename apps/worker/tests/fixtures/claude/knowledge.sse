data: {"type":"content_block_delta","index":1,"delta":{"type":"text_delta","text":"s\": [{\"title\": \"Route capacity\", \"detail\": \"A route takes at most 120 parcels; the 121st goes to the next route\", \"section\": 3}], \"risks\": [{\"title\": \"No fallback price\", \"detail\": \"When the rate service is down, dispatch stops assigning\", \"section\": 4}], \"terms\": [{\"term\": \"Linehaul\", \"meaning\": \"The long-distance leg between two sort centers\", \"section\": 5}], \"projects\": [], \"people\": [{\"name\": \"Priya Raman\", \"role\": \"Engineering manager, routing\", \"summary\": \"Owns the dispatch service\"}, {\"name\": \"Sam Okafor\", \"role\": \"Engineer\", \"summary\": \"Owns the rate service\"}]}"}}

