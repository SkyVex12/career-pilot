data: {"type":"content_block_delta","index":1,"delta":{"type":"text_delta","text":"{\"components\": [{\"name\": \"Dispatch service\", \"does\": \"Assigns parcels to linehaul routes; reads one job per parcel from the dispatch queue and picks the cheapest route with room\", \"talks_to\": [\"Dispatch queue\", \"Rate service\", \"Label service\"], \"stack\": [\"Go\", \"ECS Fargate\", \"SQS FIFO\"], \"section\": 0}, {\"name\": \"Label service\", \"does\": \"Prints carrier labels; calls each carrier's API and retries failed calls with exponential backoff, at most 5 times\", \"talks_to\": [], \"stack\": [\"Carrier APIs\"], \"section\": 0}, {\"name\": \"Rate service\", \"does\": \"Gives the dispatch service a price before it assigns a route\", \"talks_to\": [], \"stack\": [], \"section\": 0}], \"decisions\": [{\"title\": \"Keep SQS for the dispatch queue\","}}

event: content_block_delta
data: {"type":"content_block_delta","index":1,"delta":{"type":"text_delta","text":" \"what\": \"Keep SQS FIFO for the dispatch queue this quarter and revisit in Q1\", \"why\": \"Ordering per route is all the team needs\", \"alternatives\": [\"Kafka: nobody on the team runs it\"], \"tradeoff\": \"The FIFO limit of 300 messages a second per route group\", \"date\": \"2026-09-14\", \"section\": 2}], \"flows\": [{\"name\": \"Parcel dispatch\", \"summary\": \"How a parcel gets its route and label\", \"steps\": [\"The intake API writes one job per parcel to the dispatch queue, grouped by route\", \"The dispatch service asks the rate service for a price and picks the cheapest linehaul route with room\", \"It writes the assignment to the routes table and asks the label service for a label\"], \"section\": 1}], \"constraint"}}

