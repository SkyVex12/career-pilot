# Local defaults; matching values are built in, so copying this file is optional.
COPILOT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/copilot
COPILOT_VALKEY_URL=redis://localhost:6379/0
COPILOT_SQS_ENDPOINT=http://localhost:9324
COPILOT_SQS_QUEUE_URL=http://localhost:9324/000000000000/jobs
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
