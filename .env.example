# Local defaults; matching values are built in, so copying this file is optional for the stack
# alone. Copy it to .env (gitignored) to run the gateway; never commit real keys.
COPILOT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/copilot
COPILOT_VALKEY_URL=redis://localhost:6379/0
COPILOT_SQS_ENDPOINT=http://localhost:9324
COPILOT_SQS_QUEUE_URL=http://localhost:9324/000000000000/jobs
# Each service connects as its own role; `uv run copilot-dev-roles` gives the roles these
# passwords and LOGIN on the local Postgres (COPILOT_DATABASE_URL above is for migrations).
COPILOT_API_DATABASE_URL=postgresql://app_api:app_api-local@localhost:5432/copilot
COPILOT_WORKER_DATABASE_URL=postgresql://app_worker:app_worker-local@localhost:5432/copilot
COPILOT_SYSTEM_DATABASE_URL=postgresql://app_system:app_system-local@localhost:5432/copilot
# The gateway's read-only role, for company memory (live search in standups and meetings);
# unset, the gateway has no database and uses the stored packs only.
COPILOT_GATEWAY_DATABASE_URL=postgresql://app_gateway:app_gateway-local@localhost:5432/copilot
# S3-compatible store (SeaweedFS in docker compose).
COPILOT_S3_ENDPOINT=http://localhost:8333
COPILOT_S3_BUCKET=copilot-uploads
COPILOT_S3_ACCESS_KEY=local
COPILOT_S3_SECRET_KEY=local-secret
# Per-user data keys: "dev" wraps them with this local master key instead of KMS ("kms" on
# AWS, "gcp_kms" with COPILOT_GCP_KMS_KEY on GCP). Make one:
#   uv run python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
COPILOT_KEY_PROVIDER=dev
COPILOT_DEV_MASTER_KEY=
AWS_REGION=us-east-1
# ElasticMQ accepts any credentials. To reach Bedrock, replace these with real ones or remove
# them and set AWS_PROFILE; ElasticMQ accepts real credentials too.
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# Local auth: the dev token. The verifier refuses to start unless COPILOT_ENV=dev, and never
# on AWS or Compute Engine (which use Cognito or Google; README, "Deploying Stage 0"). Make a
# token with:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(24))"
COPILOT_ENV=dev
COPILOT_AUTH=dev
COPILOT_DEV_TOKEN=
COPILOT_DEV_USER_ID=0192f3a9-55c2-7b10-a4e1-1c2d3e4f5a6b
COPILOT_DEV_USER_NAME=Dev User
# In AWS (Terraform sets these): Cognito access tokens instead of the dev token.
# COPILOT_AUTH=cognito
# COPILOT_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
# COPILOT_COGNITO_CLIENT_IDS=<desktop app client id>
# COPILOT_COGNITO_DOMAIN=https://auth.<domain>   # userInfo, for first login without an email claim
# On GCP (Terraform sets these): Google ID tokens, for the allow-listed accounts only.
# COPILOT_AUTH=google
# COPILOT_GOOGLE_CLIENT_IDS=<desktop OAuth client id>.apps.googleusercontent.com
# COPILOT_GOOGLE_CLIENT_SECRET=<its secret>       # Google's desktop secrets are not confidential
# COPILOT_GOOGLE_ALLOWED_EMAILS=you@gmail.com,alex@gmail.com

# Model providers, in fallback order: bedrock, anthropic, openai, or a list such as
# "bedrock,anthropic" or "openai,anthropic" (the first gets one retry, then the next runs).
# Claude is the design default; OpenAI is a supported alternative.
COPILOT_LLM_PROVIDERS=anthropic
ANTHROPIC_API_KEY=
# Bedrock uses the AWS credentials above, or a Bedrock API key:
AWS_BEARER_TOKEN_BEDROCK=
# Retry route on Bedrock, e.g. a us. cross-region inference profile id (optional):
# COPILOT_BEDROCK_HAIKU_RETRY_MODEL=
# COPILOT_BEDROCK_SONNET_RETRY_MODEL=

# OpenAI (used when "openai" is in COPILOT_LLM_PROVIDERS). No OpenAI model is built in: you
# choose them. The values below are suggestions from OpenAI's model list as of October 2026
# (https://developers.openai.com/api/docs/models); check it before changing them. Reasoning
# effort per job: none, minimal, low, medium, high, xhigh or max, as the model accepts
# (gpt-6-luna takes none; gpt-6.1-sol and gpt-6-astra start at low). Left empty, no
# reasoning setting is sent and the model uses its default.
OPENAI_API_KEY=
COPILOT_OPENAI_DETECTOR_MODEL=gpt-6-luna
COPILOT_OPENAI_DETECTOR_REASONING=none
COPILOT_OPENAI_FAST_MODEL=gpt-6-luna
COPILOT_OPENAI_FAST_REASONING=none
COPILOT_OPENAI_DEEP_MODEL=gpt-6.1-sol
COPILOT_OPENAI_DEEP_REASONING=low
# First-token timeouts for OpenAI's live routes, instead of the live 1.5 s: measured warm
# and cached from a desktop (October 2026), the first token came after 0.8 to 2.5 s on
# gpt-6-luna and 2 to 4.3 s on gpt-6.1-sol, which reasons first.
COPILOT_OPENAI_FIRST_TOKEN_TIMEOUT_MS=3000
COPILOT_OPENAI_DEEP_FIRST_TOKEN_TIMEOUT_MS=6000
# Background jobs: memory extraction from documents (accuracy matters most), reading a job
# description, session packs, post-call summary and feedback.
COPILOT_OPENAI_EXTRACT_MODEL=gpt-6-astra
COPILOT_OPENAI_EXTRACT_REASONING=medium
COPILOT_OPENAI_JOB_MODEL=gpt-6.1-sol
COPILOT_OPENAI_JOB_REASONING=low
COPILOT_OPENAI_PACK_MODEL=gpt-6.1-sol
COPILOT_OPENAI_PACK_REASONING=medium
COPILOT_OPENAI_POSTCALL_MODEL=gpt-6.1-sol
COPILOT_OPENAI_POSTCALL_REASONING=medium
# Extra output tokens a job with reasoning gets (OpenAI counts reasoning in the output limit):
# COPILOT_OPENAI_REASONING_HEADROOM_TOKENS=2048

# Prepared-answer matching embeds questions at 1024 dimensions. "auto" uses Cohere Embed v4
# on Bedrock when bedrock is a provider, else OpenAI embeddings when openai is one and
# COPILOT_OPENAI_EMBED_MODEL is set; with the direct Claude API only, matching is off.
# "bedrock", "openai" or "none" choose explicitly. Changing the model rebuilds packs.
COPILOT_EMBEDDER=auto
COPILOT_OPENAI_EMBED_MODEL=text-embedding-3-large

# Prices per million tokens for answers.cost_usd. Claude API list prices are built in; OpenAI
# prices are not, since you choose the models. JSON, merged over the built-in ones; keys are
# model names without anthropic./us. prefixes or date suffixes. OpenAI Standard list prices
# for the models above, October 2026 (https://developers.openai.com/api/docs/pricing):
COPILOT_MODEL_PRICES={"gpt-6-luna": {"input": 0.1, "cached": 0.01, "output": 0.5}, "gpt-6.1-sol": {"input": 2, "cached": 0.1, "output": 10}, "gpt-6-astra": {"input": 10, "cached": 1, "output": 50}}

# Logs: text on the console locally (JSON with COPILOT_LOG_FORMAT=json, the default in AWS);
# COPILOT_LOG_DIR also writes JSON lines to a file per run, with the session id on each line.
# COPILOT_LOG_DIR=logs

# Speech to text: streaming for the "them" channel (gateway), pre-recorded for the user's own
# audio after the call (worker).
DEEPGRAM_API_KEY=
